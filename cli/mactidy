# ─────────────────────────── dispatch ───────────────────────────

args=(); expect_days=0; expect_names=0
for a in "$@"; do
  if [ "$expect_days" -eq 1 ]; then STALE_DAYS="$a"; expect_days=0; continue; fi
  if [ "$expect_names" -eq 1 ]; then STALE_NAMES="$a"; expect_names=0; continue; fi
  case "$a" in
    --apply) APPLY=1 ;;
    --dry-run) APPLY=0 ;;
    --days) expect_days=1 ;;
    --days=*) STALE_DAYS="${a#--days=}" ;;
    --names) expect_names=1 ;;
    --names=*) STALE_NAMES="${a#--names=}" ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]:-}"

case "${1:-scan}" in
  scan)  cmd_scan ;;
  mem|memory) cmd_mem ;;
  list)  cmd_list ;;
  clean) shift 2>/dev/null; cmd_clean "$@" ;;
  stale) cmd_stale ;;
  all)   cmd_scan; cmd_mem ;;
  help|-h|--help) cmd_help ;;
  *) printf "${RED}Unknown command: %s${RST}\n" "$1"; cmd_help; exit 1 ;;
esac
